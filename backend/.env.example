# Examples only; Django does not load this file automatically.
# Generate a secret and export it securely; never commit the resulting .env.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only after reviewing HTTPS for all subdomains and preload implications.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
# SQLite by default. PostgreSQL is required for concurrent checkout.
# POSTGRES_DB=unihome
# POSTGRES_USER=unihome
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Recovery stays disabled until a trusted frontend URL and SMTP are configured.
ACCOUNT_RESET_URL=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@localhost
